# Copy to .env and replace every replace_me value before first boot.
#   cp .env.example .env
#   openssl rand -hex 24   # use a fresh value per secret

# --- Postgres ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=replace_me

# --- Keycloak bootstrap (master realm, first start only) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace_me

# Local: http://localhost:8080
# Production: https://auth.newmarketsecurity.com
KC_HOSTNAME=http://localhost:8080
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_PORT=8080

# Public host the existing edge proxy (Caddy or Traefik) should serve.
# Do not start a second Caddy and do not bind 80/443 from this compose file.
KC_PUBLIC_HOST=auth.newmarketsecurity.com
EDGE_NETWORK=proxy

# --- OIDC confidential clients (injected into the realm on first import) ---
LOCKHAVEN_CLIENT_ID=lockhaven
LOCKHAVEN_CLIENT_SECRET=replace_me
LOCKHAVEN_ROOT_URL=http://localhost:3000
# Comma-separated. better-auth genericOAuth typically uses /api/auth/oauth2/callback/<id>
LOCKHAVEN_REDIRECT_URIS=http://localhost:3000/api/auth/oauth2/callback/lockhaven,http://localhost:3000/api/auth/callback/lockhaven
LOCKHAVEN_WEB_ORIGINS=http://localhost:3000
LOCKHAVEN_POST_LOGOUT_REDIRECT_URIS=http://localhost:3000/*

TICKETS_CLIENT_ID=tickets
TICKETS_CLIENT_SECRET=replace_me
TICKETS_ROOT_URL=http://localhost:4000
TICKETS_REDIRECT_URIS=http://localhost:4000/api/auth/oauth2/callback/tickets,http://localhost:4000/api/auth/callback/tickets
TICKETS_WEB_ORIGINS=http://localhost:4000
TICKETS_POST_LOGOUT_REDIRECT_URIS=http://localhost:4000/*
